# PostgreSQL connection used by Prisma. Example local database URL:
DATABASE_URL="postgresql://postgres:password@localhost:5432/fair_interviews?schema=public"

# Set one of these to a unique, strong value in deployed environments.
AUTH_SECRET="replace-with-a-strong-random-secret"
# NEXTAUTH_SECRET="replace-with-a-strong-random-secret"

# Resend email verification (use a sender address from a verified Resend domain in production).
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Fair Interviews <noreply@your-verified-domain.com>"

# Optional: configure both values to enable Google sign-in.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
